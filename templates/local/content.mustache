{{!
    @template format_rumbos/local/content

    Course page of the Rumbos format: the Rumbos container above the standard
    course content. Students get the standard content behind a native
    disclosure control (works without JavaScript and is keyboard accessible);
    teachers in editing mode get the core course editor expanded below the map.

    Example context (json):
    {
        "showrumbos": true,
        "collapselist": true,
        "courseid": 2,
        "embedurl": "https://rumbos.example.com/embed?host=https%3A%2F%2Flms.example.com",
        "title": "Course title example",
        "format": "rumbos",
        "sections": [],
        "sectionreturn": "null",
        "pagesectionid": "null"
    }
}}
{{#showrumbos}}
    {{> format_rumbos/embed }}
{{/showrumbos}}
{{#collapselist}}
<details class="format-rumbos-list mb-3" id="format-rumbos-list" data-region="rumbos-activity-list">
    <summary class="btn btn-secondary">{{#str}} showactivitylist, format_rumbos {{/str}}</summary>
    {{> core_courseformat/local/content }}
</details>
{{/collapselist}}
{{^collapselist}}
    {{#showrumbos}}
    <div id="format-rumbos-list" tabindex="-1" data-region="rumbos-activity-list"></div>
    {{/showrumbos}}
    {{> core_courseformat/local/content }}
{{/collapselist}}
